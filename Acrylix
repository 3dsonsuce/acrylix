local function HHXVTEQ_fake_script() -- TextLabel.rainbowbarsystem 
	local script = Instance.new('LocalScript', Title)

	--feel free to skid this, i made it via localscript because im too lazy to put it in the script
	function zigzag(X) return math.acos(math.cos(X*math.pi))/math.pi end

	counter = 0

	while wait(0.1)do
		Title.TextColor3 = Color3.fromHSV(zigzag(counter),1,1)

		counter = counter + 0.01
	end
end
coroutine.wrap(HHXVTEQ_fake_script)()

